@prefix ex: <https://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:France ex:capital ex:Paris ; rdfs:label "France" .
ex:Germany ex:capital ex:Berlin ; rdfs:label "Germany" .
ex:Italy ex:capital ex:Rome ; rdfs:label "Italy" .
ex:Spain ex:capital ex:Madrid ; rdfs:label "Spain" .
ex:Japan ex:capital ex:Tokyo ; rdfs:label "Japan" .
ex:China ex:capital ex:Beijing ; rdfs:label "China" .

ex:Paris rdfs:label "Paris" .
ex:Berlin rdfs:label "Berlin" .
ex:Rome rdfs:label "Rome" .
ex:Madrid rdfs:label "Madrid" .
ex:Tokyo rdfs:label "Tokyo" .
ex:Beijing rdfs:label "Beijing" .
