@prefix ex: <https://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Mercury ex:planetOrder 1 ; rdfs:label "Mercury" .
ex:Venus ex:planetOrder 2 ; rdfs:label "Venus" .
ex:Earth ex:planetOrder 3 ; rdfs:label "Earth" .
ex:Mars ex:planetOrder 4 ; rdfs:label "Mars" .
ex:Jupiter ex:planetOrder 5 ; rdfs:label "Jupiter" .
ex:Saturn ex:planetOrder 6 ; rdfs:label "Saturn" .
ex:Uranus ex:planetOrder 7 ; rdfs:label "Uranus" .
ex:Neptune ex:planetOrder 8 ; rdfs:label "Neptune" .
